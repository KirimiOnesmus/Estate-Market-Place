NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace_me
DB_NAME=pavilion_marketplace
# Set DB_SSL=true for a remote PostgreSQL service that requires TLS.
DB_SSL=false
# M-Pesa Daraja STK Push (use sandbox credentials first).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# Public HTTPS callback base URL, ending in /api/v1/mpesa/stk/callback (no trailing slash).
MPESA_CALLBACK_URL=
# Generate a long random secret. The callback route appends it to the URL path.
MPESA_CALLBACK_SECRET=
# Initial Super Admin bootstrap values (remove BOOTSTRAP_ADMIN_PASSWORD after setup).
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PHONE=
BOOTSTRAP_ADMIN_PASSWORD=
